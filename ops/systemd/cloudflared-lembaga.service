[Unit]
Description=Cloudflare Tunnel for Aplikasi Lembaga
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file /root/.config/lembaga/cloudflared-token
Restart=always
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
